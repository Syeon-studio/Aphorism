# 이 파일에는 변수 이름만 둔다. 실제 값은 .env.local(로컬)과 Vercel 환경변수에만 넣는다.
# .env.local 은 .gitignore 대상이며 절대 커밋하지 않는다.

# 공개 사이트 절대 URL. 도메인 확정 전에는 비워두면 *.vercel.app 주소를 쓴다.
NEXT_PUBLIC_SITE_URL=

# --- 2단계(DB 연결)부터 사용 ---
# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
SUPABASE_URL=
# 서버 전용. 브라우저 코드(NEXT_PUBLIC_*)에 절대 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 4단계(관리자 화면)부터 사용 ---
# 관리자 마스터 토큰. 24자 이상 랜덤: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
ADMIN_TOKEN=
